<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="
        http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

    <!--Here I declared School object creation 2 times, it mean it'll create two beans.-->
    <bean id="school" class="org.example.schooling.School">
    </bean>

<!--    <bean id="school2" class="org.example.schooling.School">-->
<!--    </bean>-->

<!--    <bean id="student" class="org.example.schooling.Student" scope="prototype">-->
<!--    </bean>-->

    <bean id="student" class="org.example.schooling.Student">
        <property name="age" value="21"></property>
    </bean>

    <bean id="teacher" class="org.example.schooling.Teachers">
        <constructor-arg value="21"/>
        <constructor-arg ref="school"/>

    </bean>

</beans>